	<id>https://standardebooks.org/ebooks/arthur-conan-doyle/the-return-of-sherlock-holmes</id>
	<dc:identifier>https://standardebooks.org/ebooks/arthur-conan-doyle/the-return-of-sherlock-holmes</dc:identifier>
	<title>The Return of Sherlock Holmes</title>
			<author>
			<name>Arthur Conan Doyle</name>
			<uri>https://standardebooks.org/ebooks/arthur-conan-doyle</uri>
							<schema:alternateName>Sir Arthur Ignatius Conan Doyle</schema:alternateName>
