{
  "name": "knowbase",
  "version": "3.4.0-beta.1",
  "description": "Phrontis — 本地 Windows 桌面知识管理工具（原 Knowbase Programmer Edition）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/launch.js dev",
    "build": "electron-vite build",
    "start": "node scripts/launch.js start",
    "preview": "electron-vite preview",
    "test": "node --experimental-strip-types --no-warnings scripts/test-parse-quick-date.mts",
    "pack": "electron-vite build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "d3-force": "^3.0.0",
    "defuddle": "^0.19.3",
    "heic-to": "^1.5.2",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.2",
    "ignore": "^5.3.2",
    "katex": "^0.18.4",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.0.0",
    "monaco-editor": "0.56.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.12.0",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.local.knowbase.programmer",
    "productName": "Phrontis",
    "artifactName": "Phrontis-${version}-setup.${ext}",
    "extraResources": [
      {
        "from": "resources/builtin-plugins",
        "to": "builtin-plugins"
      },
      {
        "from": "resources/dict",
        "to": "dict"
      },
      {
        "from": "clipper-extension",
        "to": "clipper-extension"
      },
      {
        "from": "resources/help",
        "to": "help"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist"
  }
}
